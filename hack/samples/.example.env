export DOMAIN_NAME=svc.local
export PUBLIC_DOMAIN_NAME=

export CLOUDFLARE_ACCOUNT_ID=
export CLOUDFLARE_TUNNEL_ID=

# Local HSM scenario for hack/samples/compose.yml: softhsm (default), nethsm (amd64 only) or nethsm-only.
export COMPOSE_PROFILES=softhsm

# NetHSM reachable from the cluster (host or host:port) and its Operator user.
# The key `bao-root-rsa` (RSA_Decryption_OAEP_SHA256, with a `label`) must exist on it.
export NETHSM_ADDRESS=
export NETHSM_OPERATOR_USERNAME=operator
export NETHSM_OPERATOR_PASSPHRASE=

export KEYCLOAK_REALM_NAME=sandbox
export KEYCLOAK_REALM_DISPLAY_NAME=sandbox

export MINIO_SITE_NAME=sandbox
export MINIO_SITE_REGION=us-east-1
